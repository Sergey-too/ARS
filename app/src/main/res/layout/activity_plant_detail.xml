<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_green"
    android:fillViewport="true"
    tools:context=".PlantDetailActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Верхний заголовок -->
        <LinearLayout
            android:id="@+id/topSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Детали растения"
                android:textColor="@color/color_text_white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Монстера"
                android:textColor="@color/color_text_light"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Карточка с фото растения -->
        <androidx.cardview.widget.CardView
            android:id="@+id/photoCard"
            android:layout_width="0dp"
            android:layout_height="280dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/color_surface_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:contentPadding="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topSection"
            app:layout_constraintWidth_percent="0.95">

            <ImageView
                android:id="@+id/ivPlantPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/plant_placeholder"
                android:contentDescription="Фото растения" />

            <!-- Индикатор если фото нет -->
            <LinearLayout
                android:id="@+id/photoPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/color_surface_light"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_photo_camera"
                    app:tint="@color/color_green_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Фото отсутствует"
                    android:textColor="@color/color_text_gray"
                    android:textSize="16sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Блок с заметками пользователя -->
        <androidx.cardview.widget.CardView
            android:id="@+id/notesCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/color_surface_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:contentPadding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/photoCard"
            app:layout_constraintWidth_percent="0.95">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Заголовок заметок -->
                <TextView
                    android:id="@+id/tvNotesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Заметки пользователя"
                    android:textColor="@color/color_text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Иконка редактирования -->
                <ImageView
                    android:id="@+id/btnEditNotes"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/color_green_primary"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Текст заметок -->
                <TextView
                    android:id="@+id/tvNotes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Поливать раз в неделю. Любит рассеянный свет. Пересаживать весной."
                    android:textColor="@color/color_text_dark"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvNotesTitle" />

                <!-- Плейсхолдер если заметок нет -->
                <TextView
                    android:id="@+id/tvNoNotes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Заметки отсутствуют. Добавьте заметки о растении."
                    android:textColor="@color/color_text_gray"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:gravity="center"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvNotesTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Блок с рекомендациями по посадке -->
        <androidx.cardview.widget.CardView
            android:id="@+id/recommendationsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@color/color_green_soft"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:contentPadding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/notesCard"
            app:layout_constraintWidth_percent="0.95">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Заголовок рекомендаций -->
                <TextView
                    android:id="@+id/tvRecommendationsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Рекомендации по посадке"
                    android:textColor="@color/color_green_dark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Иконка информации -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/color_green_dark"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Текст рекомендаций -->
                <TextView
                    android:id="@+id/tvRecommendations"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="1. Лучшее время для посадки: весна\n2. Почва: легкая, дренированная\n3. Освещение: рассеянный свет\n4. Полив: умеренный, не допускать переувлажнения\n5. Температура: 18-25°C"
                    android:textColor="@color/color_text_dark"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvRecommendationsTitle" />

                <!-- Плейсхолдер если рекомендаций нет -->
                <TextView
                    android:id="@+id/tvNoRecommendations"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Рекомендации не загружены. Включите получение рекомендаций при добавлении растения."
                    android:textColor="@color/color_text_gray"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:gravity="center"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvRecommendationsTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>