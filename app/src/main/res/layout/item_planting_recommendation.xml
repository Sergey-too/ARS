<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок: дата и день недели -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="19 января"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

            <TextView
                android:id="@+id/tvDayOfWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Понедельник"
                android:textSize="14sp"
                android:textColor="#2E7D32" />
        </LinearLayout>

        <!-- Название растения -->
        <TextView
            android:id="@+id/tvCropName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Огурец"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dp" />

        <!-- Регион -->
        <TextView
            android:id="@+id/tvRegion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Минск"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />

        <!-- Таблица погоды -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Погода"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#F5F5F5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Заголовки таблицы -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="#E0E0E0"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Параметр"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/tvCurrentValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Текущее"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvRequiredValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Норма"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Строка температуры -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Температура"
                        android:textSize="12sp"
                        android:textColor="#555555" />

                    <TextView
                        android:id="@+id/tvTempCurrent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="18°C"
                        android:textSize="12sp"
                        android:textColor="#1976D2"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvTempRequired"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="15-25°C"
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Строка влажности -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:padding="6dp"
                    android:background="#FAFAFA">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Влажность"
                        android:textSize="12sp"
                        android:textColor="#555555" />

                    <TextView
                        android:id="@+id/tvHumidityCurrent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="65%"
                        android:textSize="12sp"
                        android:textColor="#1976D2"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvHumidityRequired"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="60-80%"
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Строка осадков -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Осадки"
                        android:textSize="12sp"
                        android:textColor="#555555" />

                    <TextView
                        android:id="@+id/tvPrecipCurrent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2.5 мм"
                        android:textSize="12sp"
                        android:textColor="#1976D2"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvPrecipRequired"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=" 10 мм"
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Строка ветра -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="6dp"
                    android:background="#FAFAFA">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ветер"
                        android:textSize="12sp"
                        android:textColor="#555555" />

                    <TextView
                        android:id="@+id/tvWindCurrent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3 м/с"
                        android:textSize="12sp"
                        android:textColor="#1976D2"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvWindRequired"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=" 5 м/с"
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Кнопка посадки -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlant"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ПОСАДИТЬ"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#4CAF50"
            app:cornerRadius="12dp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>