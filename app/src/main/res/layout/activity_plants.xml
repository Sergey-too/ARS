<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_green_soft"
    tools:context=".PlantsActivity">

    <!-- Основной контент -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- AppBar с поиском и меню -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_green"
            android:elevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp">

                <androidx.appcompat.widget.Toolbar
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Мои растения"
                        android:textColor="@color/color_text_white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_gravity="start|center_vertical" />

                    <ImageView
                        android:id="@+id/btnMenu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|center_vertical"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/color_text_white"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp" />

                </androidx.appcompat.widget.Toolbar>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/searchLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:hint="Поиск растений"
                    app:boxBackgroundColor="@color/color_surface_white"
                    app:boxCornerRadiusBottomEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusTopStart="24dp"
                    app:endIconMode="clear_text"
                    app:endIconTint="@color/color_green_primary"
                    app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="@color/color_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/color_text_dark"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- RecyclerView для растений -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlants"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- Кнопка добавления (поверх всего) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/color_blue_primary"
        app:tint="@color/color_button_text_primary" />

    <!-- Выдвижная панель меню (САМЫЙ ВЕРХНИЙ СЛОЙ) -->
    <FrameLayout
        android:id="@+id/sideMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Само меню (70% экрана справа) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sideMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@color/color_surface_white"
            android:elevation="16dp"
            android:visibility="visible">

            <!-- Заголовок меню -->
            <TextView
                android:id="@+id/tvMenuTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="24dp"
                android:text="Меню"
                android:textColor="@color/color_text_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Кнопка закрытия -->
            <ImageView
                android:id="@+id/btnCloseMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_close"
                app:tint="@color/color_text_dark"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Список кнопок меню -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Кнопка 1 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu1"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:text="Посадка"
                    android:textColor="@color/color_text_dark"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_profile"
                    app:iconTint="@color/color_green_primary" />

                <!-- Кнопка 2 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu2"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:text="Прогноз погоды"
                    android:textColor="@color/color_text_dark"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_weather"
                    app:iconTint="@color/color_green_primary" />

                <!-- Кнопка 3 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu3"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:text="Удалить все записи"
                    android:textColor="@color/color_text_dark"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_close"
                    app:iconTint="@color/color_green_primary" />

                <!-- Кнопка 4 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu4"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Участки"
                    android:textColor="@color/color_text_dark"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_logout"
                    app:iconTint="@color/color_error" />

                <!-- Кнопка 5 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu5"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Выйти"
                    android:textColor="@color/color_error"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_logout"
                    app:iconTint="@color/color_error" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>