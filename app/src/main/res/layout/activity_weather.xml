<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_blue"
    android:fillViewport="true"
    tools:context=".WeatherActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Верхний заголовок -->
        <LinearLayout
            android:id="@+id/topSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_weather"
                app:tint="@color/color_text_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Прогноз погоды"
                android:textColor="@color/color_text_white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Последние 6 дней"
                android:textColor="@color/color_text_light"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Карточка с таблицей -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:elevation="8dp"
            app:cardBackgroundColor="@color/color_surface_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:contentPadding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topSection"
            app:layout_constraintWidth_percent="0.95">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Кнопка назад -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/color_blue_primary"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Заголовок формы -->
                <TextView
                    android:id="@+id/tvFormTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Метеоданные"
                    android:textColor="@color/color_text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Выбор региона -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegion"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Выберите регион"
                    app:boxStrokeColor="@color/color_input_border"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="dropdown_menu"
                    app:endIconTint="@color/color_blue_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvFormTitle">

                    <AutoCompleteTextView
                        android:id="@+id/actvRegion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:textColor="@color/color_text_dark"
                        android:textSize="16sp"
                        android:inputType="none"
                        android:completionHint="Областные города"
                        android:completionThreshold="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Кнопка обновления данных (перемещена сюда) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Обновить"
                    android:textAllCaps="false"
                    android:textColor="@color/color_button_text_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/color_blue_primary"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="@color/color_button_text_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tilRegion" />

                <!-- Информация о выбранном регионе -->
                <TextView
                    android:id="@+id/tvRegionInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Выбран: Минская область"
                    android:textColor="@color/color_text_gray"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnRefresh" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Карточка с таблицей данных -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dataCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:elevation="8dp"
            app:cardBackgroundColor="@color/color_surface_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:contentPadding="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardView"
            app:layout_constraintWidth_percent="0.95">

            <!-- Таблица -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Шапка таблицы -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/color_blue_soft"
                        android:orientation="horizontal"
                        android:paddingVertical="16dp">

                        <!-- Дата -->
                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:text="Дата"
                            android:textColor="@color/color_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Температура -->
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="Температура °C"
                            android:textColor="@color/color_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Ветер -->
                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="Ветер, м/с"
                            android:textColor="@color/color_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Давление -->
                        <TextView
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="Давление, гПа"
                            android:textColor="@color/color_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Влажность -->
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="Влажность, %"
                            android:textColor="@color/color_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Осадки -->
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="16dp"
                            android:text="Осадки, мм"
                            android:textColor="@color/color_text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Строки таблицы (остаются как были) -->
                    <!-- Строка 1 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:orientation="horizontal"
                        android:paddingVertical="20dp">

                        <TextView
                            android:id="@+id/tvDate1"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:text="25.12.2024"
                            android:textColor="@color/color_text_dark"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTemp1"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="-3°C"
                            android:textColor="@color/color_blue_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWind1"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="4.2"
                            android:textColor="@color/color_text_dark"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPressure1"
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="1015"
                            android:textColor="@color/color_text_dark"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvHumidity1"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="85%"
                            android:textColor="@color/color_text_dark"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPrecipitation1"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="16dp"
                            android:text="1.2"
                            android:textColor="@color/color_blue_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Разделитель -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_divider" />

                <!-- Строка 2 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:paddingVertical="20dp">

                    <TextView
                        android:id="@+id/tvDate2"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:text="24.12.2024"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTemp2"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="-5°C"
                        android:textColor="@color/color_blue_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWind2"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="3.8"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPressure2"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="1018"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHumidity2"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="82%"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPrecipitation2"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="16dp"
                        android:text="0.8"
                        android:textColor="@color/color_blue_primary"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Разделитель -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider" />

                <!-- Строка 3 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:paddingVertical="20dp">

                    <TextView
                        android:id="@+id/tvDate3"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:text="23.12.2024"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTemp3"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="-2°C"
                        android:textColor="@color/color_blue_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWind3"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="5.1"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPressure3"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="1013"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHumidity3"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="78%"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPrecipitation3"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="16dp"
                        android:text="0"
                        android:textColor="@color/color_blue_primary"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Разделитель -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider" />

                <!-- Строка 4 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:paddingVertical="20dp">

                    <TextView
                        android:id="@+id/tvDate4"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:text="22.12.2024"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTemp4"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="-1°C"
                        android:textColor="@color/color_blue_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWind4"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="4.5"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPressure4"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="1016"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHumidity4"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="80%"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPrecipitation4"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="16dp"
                        android:text="0.5"
                        android:textColor="@color/color_blue_primary"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Разделитель -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider" />

                <!-- Строка 5 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:paddingVertical="20dp">

                    <TextView
                        android:id="@+id/tvDate5"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:text="21.12.2024"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTemp5"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="-4°C"
                        android:textColor="@color/color_blue_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWind5"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="6.2"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPressure5"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="1012"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHumidity5"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="88%"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPrecipitation5"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="16dp"
                        android:text="2.1"
                        android:textColor="@color/color_blue_primary"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Разделитель -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider" />

                <!-- Строка 6 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="horizontal"
                    android:paddingVertical="20dp">

                    <TextView
                        android:id="@+id/tvDate6"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:text="20.12.2024"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTemp6"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="-6°C"
                        android:textColor="@color/color_blue_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWind6"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="7.0"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPressure6"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="1010"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHumidity6"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="90%"
                        android:textColor="@color/color_text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPrecipitation6"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="16dp"
                        android:text="3.5"
                        android:textColor="@color/color_blue_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

        </androidx.cardview.widget.CardView>

        <!-- Подвал с информацией -->
        <TextView
            android:id="@+id/tvUpdated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Данные обновлены: 25.12.2024 14:30"
            android:textColor="@color/color_text_light"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dataCard" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>