<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <!-- ID (60dp) -->
    <TextView
        android:id="@+id/tvPlantId"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:text="ID"
        android:textColor="@color/color_text_dark"
        android:textSize="11sp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Название (180dp) -->
    <TextView
        android:id="@+id/tvPlantName"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Название"
        android:textColor="@color/color_green_dark"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Категория (120dp) -->
    <TextView
        android:id="@+id/tvPlantCategory"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Категория"
        android:textColor="@color/color_text_dark"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Температура мин (110dp) -->
    <TextView
        android:id="@+id/tvPlantTempMin"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Мин °C"
        android:textColor="@color/color_text_dark"
        android:textSize="11sp"
        android:gravity="center"
        android:maxLines="1" />

    <!-- Температура макс (110dp) -->
    <TextView
        android:id="@+id/tvPlantTempMax"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Макс °C"
        android:textColor="@color/color_text_dark"
        android:textSize="11sp"
        android:gravity="center"
        android:maxLines="1" />

    <!-- Влажность (100dp) -->
    <TextView
        android:id="@+id/tvPlantHumidity"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Влажн"
        android:textColor="@color/color_text_dark"
        android:textSize="11sp"
        android:gravity="center"
        android:maxLines="1" />

    <!-- Ветер (80dp) -->
    <TextView
        android:id="@+id/tvPlantWind"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Ветер"
        android:textColor="@color/color_text_dark"
        android:textSize="11sp"
        android:gravity="center"
        android:maxLines="1" />

    <!-- Осадки (80dp) -->
    <TextView
        android:id="@+id/tvPlantPrecipitation"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Осадки"
        android:textColor="@color/color_text_dark"
        android:textSize="11sp"
        android:gravity="center"
        android:maxLines="1" />

    <!-- Глубина посева (80dp) -->
    <TextView
        android:id="@+id/tvPlantSowingDepth"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="Глубина"
        android:textColor="@color/color_text_dark"
        android:textSize="11sp"
        android:gravity="center"
        android:maxLines="1" />

    <!-- Кнопки действий (150dp) -->
    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditPlant"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:text="Изм"
            android:textAllCaps="false"
            android:textSize="10sp"
            android:textColor="@color/color_button_text_primary"
            app:backgroundTint="@color/color_green_primary"
            app:cornerRadius="4dp"
            app:icon="@drawable/ic_edit"
            app:iconSize="10dp"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeletePlant"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:text="Удл"
            android:textAllCaps="false"
            android:textSize="10sp"
            android:textColor="@color/color_button_text_primary"
            app:backgroundTint="@color/color_error"
            app:cornerRadius="4dp"
            app:icon="@drawable/ic_close"
            app:iconSize="10dp"
            app:iconPadding="0dp" />

    </LinearLayout>

</LinearLayout>